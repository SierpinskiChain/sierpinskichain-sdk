{
  "name": "@sierpinskichain/sdk",
  "version": "0.1.1",
  "description": "TypeScript SDK for the Sierpinski network — typed RPC client and React hooks",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./hooks": {
      "types": "./dist/types/hooks.d.ts",
      "import": "./dist/esm/hooks.js",
      "require": "./dist/cjs/hooks.js"
    },
    "./wallet": {
      "types": "./dist/types/wallet.d.ts",
      "import": "./dist/esm/wallet.js",
      "require": "./dist/cjs/wallet.js"
    },
    "./contract": {
      "types": "./dist/types/contract.d.ts",
      "import": "./dist/esm/contract.js",
      "require": "./dist/cjs/contract.js"
    },
    "./storage": {
      "types": "./dist/types/storage.d.ts",
      "import": "./dist/esm/storage.js",
      "require": "./dist/cjs/storage.js"
    },
    "./ai": {
      "types": "./dist/types/ai.d.ts",
      "import": "./dist/esm/ai.js",
      "require": "./dist/cjs/ai.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build:esm": "tsc -p tsconfig.build.esm.json",
    "build:cjs": "tsc -p tsconfig.build.cjs.json",
    "build:types": "tsc -p tsconfig.build.types.json",
    "build:cjs-meta": "mkdir -p dist/cjs && printf '{\"type\":\"commonjs\"}\\n' > dist/cjs/package.json",
    "build": "bun run clean && bun run build:esm && bun run build:cjs && bun run build:types && bun run build:cjs-meta",
    "prepublishOnly": "bun run test && bun run typecheck && bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "dependencies": {
    "@noble/curves": "^1.4.0",
    "@noble/hashes": "^1.4.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/bun": "latest",
    "@types/react": "^18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": ["sierpinski", "sdk", "rpc", "blockchain", "react-hooks"],
  "repository": {
    "type": "git",
    "url": "https://github.com/SierpinskiChain/sierpinskichain-sdk"
  },
  "license": "MIT"
}
